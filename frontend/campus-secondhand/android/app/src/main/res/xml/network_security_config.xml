<?xml version="1.0" encoding="utf-8"?>
<!--
  课程演示用：后端通常是局域网 IP 上的 http://x.x.x.x:8080，没有 HTTPS 证书。
  Android 9+ 默认禁止明文 HTTP，这里放开。正式上线换成 HTTPS 后应删除 base-config 的放行。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
