{
  "name": "waste-reuse-platform",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android && cap sync android",
    "apk:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "electron:dev": "electron . --dev",
    "electron:build:win": "vite build --mode desktop && electron-builder --win --x64",
    "electron:build:linux": "vite build --mode desktop && electron-builder --linux --x64 --dir",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.3.12",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "3.7.4",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16"
  },
  "main": "electron/main.cjs",
  "description": "校园二手交易平台桌面客户端",
  "author": "第三组"
}
